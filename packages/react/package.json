{
  "name": "@open-intelligent-ui/react",
  "version": "0.1.0",
  "description": "Define zod-typed React component libraries, generate system prompts, and render streamed model output in a sandbox",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chat": {
      "import": {
        "types": "./dist/chat.d.mts",
        "default": "./dist/chat.mjs"
      },
      "require": {
        "types": "./dist/chat.d.cts",
        "default": "./dist/chat.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node ../core/scripts/build-sandbox.mjs && vitest run --root ../.. packages/react",
    "typecheck": "tsc --noEmit",
    "check:publint": "publint",
    "prepublishOnly": "pnpm build && publint"
  },
  "keywords": [
    "generative-ui",
    "react",
    "llm",
    "streaming",
    "renderer",
    "zod",
    "prompt-generation"
  ],
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.2.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@open-intelligent-ui/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "zod": "^4.0.0"
  }
}
