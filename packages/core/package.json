{
  "name": "@open-intelligent-ui/core",
  "version": "0.1.0",
  "description": "Compiler, sandboxed runtime and framework-agnostic component libraries for live UI from model output",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compiler": {
      "import": {
        "types": "./dist/compiler.d.mts",
        "default": "./dist/compiler.mjs"
      },
      "require": {
        "types": "./dist/compiler.d.cts",
        "default": "./dist/compiler.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-sandbox.mjs && tsdown",
    "test": "node scripts/build-sandbox.mjs && vitest run --root ../.. packages/core",
    "typecheck": "node scripts/build-sandbox.mjs && tsc --noEmit",
    "check:publint": "publint",
    "prepublishOnly": "pnpm build && publint"
  },
  "keywords": [
    "generative-ui",
    "llm",
    "streaming",
    "compiler",
    "sandbox",
    "zod"
  ],
  "devDependencies": {
    "esbuild": "^0.25.0",
    "vitest": "^3.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  }
}
