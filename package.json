{
  "name": "@open-intelligent-ui/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/**\" build",
    "pretest": "node packages/core/scripts/build-sandbox.mjs",
    "test": "vitest run",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint packages examples",
    "format": "prettier --write packages examples \"*.{json,ts,cjs,md}\"",
    "format:check": "prettier --check packages examples \"*.{json,ts,cjs,md}\"",
    "publint": "pnpm -r --filter \"./packages/**\" check:publint",
    "chat": "pnpm --filter example-chat dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^3.2.4",
    "publint": "^0.3.25",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.33.0"
}
